---
const columns = [
  {
    heading: "Product",
    links: ["How it works", "Exchange rates", "Transfer fees", "Track a transfer"],
  },
  {
    heading: "Company",
    links: ["About us", "Careers", "Press", "Blog"],
  },
  {
    heading: "Support",
    links: ["Help centre", "Contact us", "Security", "System status"],
  },
];

const socials = [
  {
    name: "X",
    path: "M12.6 1.5h2.4l-5.2 6 6.2 8.2h-4.9l-3.8-5-4.4 5H.5l5.6-6.4L.2 1.5h5l3.4 4.6 4-4.6Zm-.9 13.1h1.4L4.4 2.9H3l8.7 11.7Z",
  },
  {
    name: "LinkedIn",
    path: "M4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM2.3 7.4h3.4V17H2.3V7.4Zm5.6 0h3.3v1.3h.1c.5-.9 1.6-1.6 3-1.6 3.1 0 3.7 2 3.7 4.7V17h-3.4v-4.5c0-1.1 0-2.5-1.6-2.5s-1.8 1.2-1.8 2.4V17H7.9V7.4Z",
  },
  {
    name: "Instagram",
    path: "M9.5 1.5c2.2 0 2.4 0 3.3.1.8 0 1.3.2 1.6.3.4.2.7.4 1 .7.3.3.5.6.7 1 .1.3.3.8.3 1.6 0 .9.1 1.1.1 3.3s0 2.4-.1 3.3c0 .8-.2 1.3-.3 1.6-.2.4-.4.7-.7 1-.3.3-.6.5-1 .7-.3.1-.8.3-1.6.3-.9 0-1.1.1-3.3.1s-2.4 0-3.3-.1c-.8 0-1.3-.2-1.6-.3-.4-.2-.7-.4-1-.7-.3-.3-.5-.6-.7-1-.1-.3-.3-.8-.3-1.6 0-.9-.1-1.1-.1-3.3s0-2.4.1-3.3c0-.8.2-1.3.3-1.6.2-.4.4-.7.7-1 .3-.3.6-.5 1-.7.3-.1.8-.3 1.6-.3.9 0 1.1-.1 3.3-.1Zm0 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0 6.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2ZM14.6 5a.9.9 0 1 1-1.9 0 .9.9 0 0 1 1.9 0Z",
  },
];
---

<footer class="relative isolate">
  <!-- Soft divider that fades out at both ends instead of a hard rule -->
  <div
    class="h-px w-full"
    style="background-image: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.9) 18%, rgba(255,255,255,0.9) 82%, rgba(255,255,255,0) 100%);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-[1680px] px-6 py-14 sm:px-8 lg:px-16 lg:py-16 xl:px-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-5">
        <a href="/" aria-label="FuseRemit home">
          <img
            src="/images/fuseremit-logo.webp"
            alt="FuseRemit"
            width="713"
            height="160"
            loading="lazy"
            class="h-9 w-auto lg:h-10"
          />
        </a>
        <p class="mt-5 max-w-[34ch] text-[16px] leading-[1.6] text-slate lg:text-[17px]">
          A more thoughtful way to send money to the people who matter.
        </p>

        <ul class="mt-7 flex items-center gap-3">
          {
            socials.map((social) => (
              <li>
                <a
                  href="#"
                  aria-label={social.name}
                  class="glass flex h-11 w-11 items-center justify-center rounded-full text-ink transition-colors duration-200 hover:text-brand"
                >
                  <svg width="18" height="18" viewBox="0 0 19 19" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true">
                    <path d={social.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-7 lg:gap-8">
        {
          columns.map((column) => (
            <div>
              <h2 class="text-[15px] font-bold tracking-[0.01em] text-ink lg:text-[16px]">
                {column.heading}
              </h2>
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href="#"
                      class="text-[15px] text-slate transition-colors duration-200 hover:text-brand lg:text-[16px]"
                    >
                      {link}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/70 pt-7 sm:flex-row sm:items-center sm:justify-between lg:mt-14"
    >
      <p class="text-[14px] text-slate lg:text-[15px]">
        &copy; {new Date().getFullYear()} FuseRemit. All rights reserved.
      </p>
      <ul class="flex flex-wrap items-center gap-x-7 gap-y-2">
        {
          ["Privacy policy", "Terms of service", "Cookies"].map((item) => (
            <li>
              <a
                href="#"
                class="text-[14px] text-slate transition-colors duration-200 hover:text-brand lg:text-[15px]"
              >
                {item}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
