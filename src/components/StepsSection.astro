---
const steps = [
  {
    n: "1",
    title: "Choose an amount",
    body: "Enter how much you want to send and select your preferred currency.",
    img: "/images/steps/coins.png",
    alt: "Stacked 3D dollar and euro coins",
    width: 1079,
    height: 813,
  },
  {
    n: "2",
    title: "Add a recipient",
    body: "Enter your recipient's details securely and save them for next time.",
    img: "/images/steps/person.png",
    alt: "3D character beside a contact card with an add button",
    width: 981,
    height: 679,
  },
  {
    n: "3",
    title: "Confirm your transfer",
    body: "Review your details and confirm to send your money.",
    img: "/images/steps/plane.png",
    alt: "3D paper plane circled by orbit rings with a confirmation checkmark",
    width: 1278,
    height: 850,
  },
];
---

<section id="how-it-works" class="relative isolate overflow-hidden">
  <!-- Airy blue backdrop: lightest along the top, deepening toward the lower left -->
  <div
    class="absolute inset-0 -z-20"
    style="background-image: linear-gradient(180deg, #FBFDFE 0%, #EDF6FE 14%, #E1EFFD 38%, #DCEBFD 66%, #E4F1FD 86%, #EFF7FE 100%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10"
    style="background-image:
      radial-gradient(42% 38% at 2% 76%, rgba(166, 203, 250, 0.72) 0%, rgba(166, 203, 250, 0) 72%),
      radial-gradient(38% 34% at 99% 28%, rgba(176, 212, 251, 0.5) 0%, rgba(176, 212, 251, 0) 72%),
      radial-gradient(55% 32% at 50% -4%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(104deg, rgba(255, 255, 255, 0) 32%, rgba(255, 255, 255, 0.45) 48%, rgba(255, 255, 255, 0) 62%);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-[1680px] px-6 py-16 sm:px-8 lg:px-16 lg:py-20 xl:px-24 xl:py-[72px]">
    <!-- Heading block -->
    <div class="text-center">
      <img
        src="/images/fuseremit-logo.png"
        alt="FuseRemit"
        width="1806"
        height="405"
        loading="lazy"
        class="mx-auto h-8 w-auto lg:h-10 xl:h-11"
      />

      <p
        class="mt-9 font-semibold uppercase text-brand lg:mt-12"
        style="font-size: clamp(0.75rem, 1.1vw, 1.15rem); letter-spacing: 0.3em;"
      >
        How it works
      </p>

      <h2
        class="mt-3 font-bold leading-[1.1] tracking-[-0.025em] text-ink lg:mt-4"
        style="font-size: clamp(2rem, 3.65vw, 3.85rem);"
      >
        Send money in three simple steps
      </h2>

      <p
        class="mx-auto mt-4 max-w-[46ch] text-slate"
        style="font-size: clamp(1.0625rem, 1.55vw, 1.6rem);"
      >
        A thoughtful experience, from start to finish.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative mt-14 lg:mt-[30px]">
      <!-- Dotted connectors, drawn across the illustration band -->
      <svg
        class="pointer-events-none absolute inset-x-0 top-0 z-10 hidden h-[235px] w-full lg:block"
        viewBox="0 0 1481 235"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <g stroke="#8DC2F7" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="2 14">
          <path d="M362 92 C 430 92, 455 124, 575 123" />
          <path d="M916 120 C 955 120, 968 102, 982 102 C 1002 102, 1012 106, 1040 101" />
        </g>
        <g fill="#FFFFFF" stroke="#8DC2F7" stroke-width="2.5">
          <circle cx="356" cy="92" r="6" />
          <circle cx="578" cy="123" r="6" />
          <circle cx="982" cy="102" r="6" />
        </g>
      </svg>

      <ol class="grid grid-cols-1 gap-16 sm:gap-20 lg:grid-cols-3 lg:gap-[60px]">
        {
          steps.map((step) => (
            <li class="flex flex-col items-center">
              <img
                src={step.img}
                alt={step.alt}
                width={step.width}
                height={step.height}
                loading="lazy"
                decoding="async"
                class="relative z-20 h-[190px] w-auto max-w-none object-contain sm:h-[220px] lg:h-[235px]"
              />

              <div class="glass -mt-[75px] w-full rounded-[32px] px-7 pb-9 pt-[82px] lg:-mt-[93px] lg:px-[35px] lg:pb-[42px] lg:pt-[95px]">
                <div class="flex items-center gap-4 lg:gap-[19px]">
                  <span
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-white/80 bg-[#DCEBFD] font-semibold text-brand lg:h-14 lg:w-14"
                    style="font-size: clamp(1.125rem, 1.5vw, 1.625rem);"
                    aria-hidden="true"
                  >
                    {step.n}
                  </span>
                  <h3
                    class="font-bold leading-tight text-ink"
                    style="font-size: clamp(1.25rem, 1.55vw, 1.625rem);"
                  >
                    {step.title}
                  </h3>
                </div>

                <p
                  class="mt-3 pl-16 leading-[1.6] text-slate lg:pl-[75px]"
                  style="font-size: clamp(1rem, 1.14vw, 1.1875rem);"
                >
                  {step.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Closing link -->
    <div class="mt-12 flex justify-center lg:mt-[52px]">
      <a
        href="#how-it-works"
        class="glass group inline-flex items-center gap-4 rounded-full px-10 py-4 font-semibold text-brand-ink transition-transform duration-200 hover:-translate-y-0.5 lg:px-14 lg:py-[22px]"
        style="font-size: clamp(1.0625rem, 1.32vw, 1.375rem);"
      >
        Explore how it works
        <svg
          width="26"
          height="16"
          viewBox="0 0 26 16"
          fill="none"
          aria-hidden="true"
          class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        >
          <path
            d="M1 8h23M17 1.5 24 8l-7 6.5"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
