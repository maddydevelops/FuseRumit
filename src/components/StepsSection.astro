---
const steps = [
  {
    n: "1",
    title: "Choose an amount",
    body: "Enter how much you want to send and select your preferred currency.",
    img: "/images/steps/coins.png",
    alt: "Stacked 3D dollar and euro coins",
    width: 1079,
    height: 813,
  },
  {
    n: "2",
    title: "Add a recipient",
    body: "Enter your recipient's details securely and save them for next time.",
    img: "/images/steps/person.png",
    alt: "3D character beside a contact card with an add button",
    width: 981,
    height: 679,
  },
  {
    n: "3",
    title: "Confirm your transfer",
    body: "Review your details and confirm to send your money.",
    img: "/images/steps/plane.png",
    alt: "3D paper plane circled by orbit rings with a confirmation checkmark",
    width: 1278,
    height: 850,
  },
];
---

<!--
  Every vertical metric is driven by --band (the illustration height) and viewport
  height, so the whole section scales down to fit the screen instead of overflowing.
-->
<section
  id="how-it-works"
  class="relative isolate flex flex-col justify-center overflow-hidden lg:min-h-svh"
  style="
    --band: clamp(128px, min(14.2vw, 24.5vh), 235px);
    --overlap: calc(var(--band) * 0.4);
    --badge: clamp(38px, min(3.5vw, 6vh), 56px);
    --badge-gap: clamp(10px, 1.05vw, 17px);
    --card-pad: clamp(18px, 1.85vw, 31px);"
>
  <!-- Accents only — the base gradient lives on the page wrapper, so there is no
       seam where this section meets the hero -->
  <div
    class="absolute inset-0 -z-10"
    style="
      background-image:
        radial-gradient(42% 38% at 2% 76%, rgba(166, 203, 250, 0.6) 0%, rgba(166, 203, 250, 0) 72%),
        radial-gradient(38% 34% at 99% 28%, rgba(176, 212, 251, 0.45) 0%, rgba(176, 212, 251, 0) 72%),
        linear-gradient(104deg, rgba(255, 255, 255, 0) 32%, rgba(255, 255, 255, 0.4) 48%, rgba(255, 255, 255, 0) 62%);
      -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #000 26%, #000 100%);
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #000 26%, #000 100%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto w-full max-w-[1680px] px-6 sm:px-8 lg:px-16 xl:px-24"
    style="padding-top: clamp(1.5rem, 4.2vh, 3rem); padding-bottom: clamp(2rem, 6.6vh, 4.5rem);"
  >
    <!-- Heading block -->
    <div class="text-center">
      <img
        src="/images/fuseremit-logo.png"
        alt="FuseRemit"
        width="1806"
        height="405"
        loading="lazy"
        class="mx-auto w-auto"
        style="height: clamp(28px, min(2.7vw, 4.8vh), 45px);"
      />

      <p
        class="font-semibold uppercase text-brand"
        style="
          margin-top: clamp(1rem, 3.8vh, 2.75rem);
          font-size: clamp(0.7rem, min(1.1vw, 1.95vh), 1.15rem);
          letter-spacing: 0.3em;"
      >
        How it works
      </p>

      <h2
        class="font-bold leading-[1.08] tracking-[-0.025em] text-ink"
        style="
          margin-top: clamp(0.5rem, 1.6vh, 1rem);
          font-size: clamp(1.75rem, min(3.65vw, 6.5vh), 3.85rem);"
      >
        Send money in three simple steps
      </h2>

      <p
        class="mx-auto max-w-[46ch] text-slate"
        style="
          margin-top: clamp(0.5rem, 1.3vh, 0.9rem);
          font-size: clamp(1rem, min(1.55vw, 2.8vh), 1.6rem);"
      >
        A thoughtful experience, from start to finish.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative" style="margin-top: clamp(1.25rem, 2.6vh, 1.75rem);">
      <!-- Dotted connectors, drawn across the illustration band -->
      <svg
        class="pointer-events-none absolute inset-x-0 top-0 z-10 hidden w-full lg:block"
        style="height: var(--band);"
        viewBox="0 0 1481 235"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <g stroke="#8DC2F7" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="2 14">
          <path d="M362 92 C 430 92, 455 124, 575 123" />
          <path d="M916 120 C 955 120, 968 102, 982 102 C 1002 102, 1012 106, 1040 101" />
        </g>
        <g fill="#FFFFFF" stroke="#8DC2F7" stroke-width="2.5">
          <circle cx="356" cy="92" r="6" />
          <circle cx="578" cy="123" r="6" />
          <circle cx="982" cy="102" r="6" />
        </g>
      </svg>

      <ol class="grid grid-cols-1 gap-14 sm:gap-16 lg:grid-cols-3 lg:gap-8 2xl:gap-[60px]">
        {
          steps.map((step) => (
            <li class="flex flex-col items-center">
              <img
                src={step.img}
                alt={step.alt}
                width={step.width}
                height={step.height}
                loading="lazy"
                decoding="async"
                class="relative z-20 w-auto max-w-none object-contain"
                style="height: var(--band);"
              />

              <div
                class="glass flex w-full flex-1 flex-col rounded-[28px] lg:rounded-[32px]"
                style="
                  margin-top: calc(var(--overlap) * -1);
                  padding-top: calc(var(--overlap) + clamp(14px, 2.4vh, 24px));
                  padding-left: var(--card-pad);
                  padding-right: var(--card-pad);
                  padding-bottom: clamp(16px, 3.6vh, 42px);"
              >
                <div class="flex items-center" style="gap: var(--badge-gap);">
                  <span
                    class="flex shrink-0 items-center justify-center rounded-full border-2 border-white/80 bg-[#DCEBFD] font-semibold text-brand"
                    style="
                      height: var(--badge);
                      width: var(--badge);
                      font-size: clamp(1rem, min(1.5vw, 2.7vh), 1.625rem);"
                    aria-hidden="true"
                  >
                    {step.n}
                  </span>
                  <h3
                    class="font-bold leading-tight text-ink"
                    style="font-size: clamp(1.125rem, min(1.55vw, 2.8vh), 1.625rem);"
                  >
                    {step.title}
                  </h3>
                </div>

                <p
                  class="text-slate"
                  style="
                    margin-top: clamp(0.4rem, 1.2vh, 0.75rem);
                    padding-left: calc(var(--badge) + var(--badge-gap));
                    font-size: clamp(0.9375rem, min(0.95vw, 1.72vh), 1.0625rem);
                    line-height: 1.58;"
                >
                  {step.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Closing link -->
    <div class="flex justify-center" style="margin-top: clamp(1.25rem, 4.6vh, 3.25rem);">
      <a
        href="#how-it-works"
        class="glass group inline-flex items-center rounded-full font-semibold text-brand-ink transition-transform duration-200 hover:-translate-y-0.5"
        style="
          gap: clamp(0.75rem, 1vw, 1rem);
          padding: clamp(0.75rem, 2.4vh, 1.375rem) clamp(1.75rem, 3.4vw, 3.5rem);
          font-size: clamp(1rem, min(1.32vw, 2.4vh), 1.375rem);"
      >
        Explore how it works
        <svg
          width="26"
          height="16"
          viewBox="0 0 26 16"
          fill="none"
          aria-hidden="true"
          class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        >
          <path
            d="M1 8h23M17 1.5 24 8l-7 6.5"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
