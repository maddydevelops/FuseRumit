---
import Navbar from "./Navbar.astro";
---

<section class="relative isolate flex flex-col overflow-hidden lg:min-h-svh">
  <!-- Accent wash over the page-wide gradient; faded out at the bottom so the
       next section blends in with no visible seam -->
  <div
    class="absolute inset-0 -z-10"
    style="
      background-image:
        radial-gradient(60% 55% at 72% 38%, rgba(197, 223, 253, 0.5) 0%, rgba(197, 223, 253, 0) 70%),
        radial-gradient(45% 45% at 12% 18%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 70%),
        linear-gradient(112deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.3) 44%, rgba(255, 255, 255, 0) 66%, rgba(186, 216, 250, 0.4) 100%);
      -webkit-mask-image: linear-gradient(180deg, #000 52%, rgba(0, 0, 0, 0) 100%);
      mask-image: linear-gradient(180deg, #000 52%, rgba(0, 0, 0, 0) 100%);"
    aria-hidden="true"
  >
  </div>

  <Navbar />

  <div
    class="mx-auto grid max-w-[1680px] grid-cols-1 items-center gap-10 px-6 pb-16 pt-8 sm:px-8 lg:grid-cols-12 lg:content-center lg:gap-6 lg:px-16 lg:pb-4 lg:pt-0 xl:px-24 xl:pb-6 lg:flex-1"
  >
    <!-- Copy -->
    <div class="min-w-0 text-center lg:col-span-5 lg:py-12 lg:text-left xl:py-20">
      <span
        class="inline-flex items-center rounded-full bg-pill px-5 py-2.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-ring sm:px-6 sm:text-[12px] sm:tracking-[0.26em] lg:px-7 lg:text-[13px]"
      >
        Money without borders
      </span>

      <h1
        class="mt-6 font-bold leading-[1.08] tracking-[-0.025em] text-ink lg:mt-9"
        style="font-size: clamp(2.25rem, 4.55vw, 4.75rem);"
      >
        Send money.<br />
        <span class="text-brand lg:whitespace-nowrap">Share a moment.</span>
      </h1>

      <p
        class="mx-auto mt-5 max-w-[34ch] font-normal leading-[1.52] text-muted lg:mx-0 lg:mt-8 lg:max-w-none"
        style="font-size: clamp(1.0625rem, 1.45vw, 1.4rem);"
      >
        A more thoughtful way to send money <br class="hidden lg:block" />to the people who matter.
      </p>

      <div
        class="mt-8 flex flex-col items-stretch gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center lg:mt-12 lg:justify-start lg:gap-4 2xl:gap-5"
      >
        <a
          href="#get-started"
          class="btn-brand group inline-flex items-center justify-center gap-3 whitespace-nowrap rounded-full px-8 py-4 text-[16px] font-semibold text-white 2xl:text-[19px] shadow-cta transition-transform duration-200 hover:-translate-y-0.5 2xl:px-11 2xl:py-[18px] 2xl:text-[19px]"
        >
          Get started
          <svg
            width="22"
            height="16"
            viewBox="0 0 22 16"
            fill="none"
            aria-hidden="true"
            class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
          >
            <path
              d="M1 8h19M13.5 1.5 20 8l-6.5 6.5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>

        <button
          type="button"
          data-open-video
          class="group inline-flex items-center justify-center gap-3 whitespace-nowrap rounded-full border border-hairline bg-white/85 px-7 py-[14px] text-[16px] font-semibold text-ink 2xl:text-[19px] shadow-ghost backdrop-blur transition-colors duration-200 hover:border-brand/40 hover:bg-white 2xl:px-8 2xl:py-4 2xl:text-[19px]"
        >
          See how it works
          <span
            class="btn-brand flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-white transition-transform duration-200 group-hover:scale-105 2xl:h-9 2xl:w-9"
          >
            <svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
              <path d="M9.2 5.13a1 1 0 0 1 0 1.74l-7.2 4.1A1 1 0 0 1 .5 10.1V1.9A1 1 0 0 1 2 1.03l7.2 4.1Z"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>

    <!-- 3D scene -->
    <div class="flex min-w-0 justify-center lg:col-span-7 lg:justify-end xl:-mr-10">
      <img
        src="/images/hero-scene.png"
        alt="FuseRemit app sending $500 to Nigeria, surrounded by currency coins, a 3D globe and live transfer notifications"
        width="1316"
        height="1195"
        fetchpriority="high"
        decoding="async"
        class="hero-float mx-auto block w-full max-w-[560px] drop-shadow-[0_40px_60px_rgba(12,45,110,0.10)] sm:max-w-[660px] lg:max-h-[76svh] lg:w-auto lg:max-w-full"
      />
    </div>
  </div>
</section>
